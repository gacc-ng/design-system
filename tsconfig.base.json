{
    "compileOnSave": false,
    "compilerOptions": {
        "rootDir": ".",
        "sourceMap": true,
        "declaration": false,
        "moduleResolution": "bundler",
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "importHelpers": true,
        "target": "es2015",
        "module": "esnext",
        "lib": ["es2020", "dom"],
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "strict": false,
        "paths": {
            "@gacc-ng/ui": ["./libs/shared/ui/src/index.ts"],
            "@gacc-ng/ui/badge": ["./libs/shared/ui/badge/src/index.ts"],
            "@gacc-ng/ui/button": ["./libs/shared/ui/button/src/index.ts"],
            "@gacc-ng/ui/input": ["./libs/shared/ui/input/src/index.ts"],
            "@gacc-ng/ui/label": ["./libs/shared/ui/label/src/index.ts"],
            "@gacc-ng/ui/utils": ["./libs/shared/ui/utils/src/index.ts"],
            "@gacc-ng/ui/card": ["./libs/shared/ui/card/src/index.ts"],
            "@gacc-ng/ui/separator": ["./libs/shared/ui/separator/src/index.ts"],
            "@gacc-ng/ui/switch": ["./libs/shared/ui/switch/src/index.ts"],
            "@gacc-ng/ui/checkbox": ["./libs/shared/ui/checkbox/src/index.ts"],
            "@gacc-ng/ui/radio-group": ["./libs/shared/ui/radio-group/src/index.ts"],
            "@gacc-ng/ui/textarea": ["./libs/shared/ui/textarea/src/index.ts"],
            "@gacc-ng/ui/avatar": ["./libs/shared/ui/avatar/src/index.ts"],
            "@gacc-ng/ui/skeleton": ["./libs/shared/ui/skeleton/src/index.ts"],
            "@gacc-ng/ui/spinner": ["./libs/shared/ui/spinner/src/index.ts"],
            "@gacc-ng/ui/kbd": ["./libs/shared/ui/kbd/src/index.ts"],
            "@gacc-ng/ui/alert": ["./libs/shared/ui/alert/src/index.ts"],
            "@gacc-ng/ui/tooltip": ["./libs/shared/ui/tooltip/src/index.ts"],
            "@gacc-ng/ui/toggle": ["./libs/shared/ui/toggle/src/index.ts"],
            "@gacc-ng/ui/toggle-group": ["./libs/shared/ui/toggle-group/src/index.ts"],
            "@gacc-ng/ui/dialog": ["./libs/shared/ui/dialog/src/index.ts"],
            "@gacc-ng/ui/alert-dialog": ["./libs/shared/ui/alert-dialog/src/index.ts"],
            "@gacc-ng/ui/popover": ["./libs/shared/ui/popover/src/index.ts"],
            "@gacc-ng/ui/sheet": ["./libs/shared/ui/sheet/src/index.ts"],
            "@gacc-ng/ui/tabs": ["./libs/shared/ui/tabs/src/index.ts"],
            "@gacc-ng/ui/accordion": ["./libs/shared/ui/accordion/src/index.ts"],
            "@gacc-ng/ui/collapsible": ["./libs/shared/ui/collapsible/src/index.ts"],
            "@gacc-ng/ui/breadcrumb": ["./libs/shared/ui/breadcrumb/src/index.ts"],
            "@gacc-ng/ui/dropdown-menu": ["./libs/shared/ui/dropdown-menu/src/index.ts"],
            "@gacc-ng/ui/select": ["./libs/shared/ui/select/src/index.ts"],
            "@gacc-ng/ui/slider": ["./libs/shared/ui/slider/src/index.ts"]
        }
    },
    "exclude": ["node_modules", "tmp"]
}
