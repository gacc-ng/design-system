{
    "mcpServers": {
        "nx-mcp": {
            "type": "stdio",
            "command": "npx",
            "args": ["nx", "mcp"]
        },
        "spartan-ng": {
            "type": "stdio",
            "command": "npx",
            "args": ["-y", "@spartan-ng/mcp"]
        },
        "storybook": {
            "type": "http",
            "url": "http://localhost:4400/mcp"
        }
    }
}
