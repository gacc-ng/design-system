{
    "name": "storybook",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/storybook",
    "prefix": "gacc",
    "tags": ["type:app", "scope:storybook"],
    "implicitDependencies": ["ui"],
    "targets": {
        "storybook": {
            "options": {
                "port": 4400
            },
            "configurations": {
                "ci": {
                    "loglevel": "warn"
                }
            }
        },
        "build-storybook": {
            "options": {
                "output-dir": "dist/storybook"
            },
            "configurations": {
                "ci": {
                    "loglevel": "warn"
                }
            }
        },
        "static-storybook": {
            "options": {
                "staticFilePath": "apps/storybook/dist/storybook",
                "port": 4400
            }
        }
    }
}
