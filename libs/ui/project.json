{
    "name": "ui",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "libs/ui",
    "prefix": "gacc",
    "projectType": "library",
    "tags": [],
    "targets": {
        "build": {
            "executor": "nx:noop",
            "dependsOn": ["build-lib", "build-schematics"]
        },
        "build-lib": {
            "executor": "@nx/angular:ng-packagr-lite",
            "outputs": ["{workspaceRoot}/dist/libs/ui"],
            "defaultConfiguration": "production",
            "options": {
                "project": "libs/ui/ng-package.json",
                "tsConfig": "libs/ui/tsconfig.lib.json"
            },
            "configurations": {
                "production": {
                    "tsConfig": "libs/ui/tsconfig.lib.prod.json"
                },
                "development": {}
            }
        },
        "build-schematics": {
            "executor": "nx:run-commands",
            "dependsOn": ["build-lib"],
            "inputs": ["{projectRoot}/schematics/**/*", "{workspaceRoot}/tools/scripts/build-schematics.mjs"],
            "outputs": ["{workspaceRoot}/dist/libs/ui/schematics"],
            "options": {
                "command": "node tools/scripts/build-schematics.mjs"
            }
        },
        "test-schematics": {
            "executor": "nx:run-commands",
            "dependsOn": ["build-schematics"],
            "inputs": ["{projectRoot}/schematics/**/*", "{workspaceRoot}/dist/libs/ui/schematics/**/*"],
            "options": {
                "command": "pnpm vitest run libs/ui/schematics"
            }
        },
        "validate-package": {
            "executor": "nx:run-commands",
            "dependsOn": ["build"],
            "inputs": ["{workspaceRoot}/dist/libs/ui/**/*", "{workspaceRoot}/tools/scripts/validate-package.mjs"],
            "options": {
                "command": "node tools/scripts/validate-package.mjs dist/libs/ui"
            }
        },
        "test": {
            "executor": "@nx/angular:unit-test",
            "options": {
                "watch": false,
                "buildTarget": "ui:build-lib",
                "tsConfig": "libs/ui/tsconfig.spec.json",
                "exclude": ["libs/ui/schematics/**", "**/schematics/**"]
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint"
        }
    }
}
