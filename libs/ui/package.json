{
    "name": "@gacc-ng/ui",
    "version": "0.2.0",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/gacc-ng/design-system.git",
        "directory": "libs/ui"
    },
    "schematics": "./schematics/collection.json",
    "ng-add": {
        "save": "dependencies"
    },
    "ng-update": {
        "migrations": "./schematics/migration.json",
        "packageGroup": [
            "@gacc-ng/ui"
        ]
    },
    "peerDependencies": {
        "@angular-devkit/schematics": ">=19.0.0",
        "@schematics/angular": ">=19.0.0",
        "@angular/cdk": ">=21.0.0",
        "@angular/common": "^22.2.0",
        "@angular/core": "^22.2.0",
        "@angular/forms": ">=21.0.0",
        "@ng-icons/core": ">=36.0.0",
        "@ng-icons/lucide": ">=36.0.0",
        "@spartan-ng/brain": "^1.8.0",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": ">=4.0.0",
        "tw-animate-css": ">=1.0.0",
        "@angular/router": "~22.2.3",
        "rxjs": "~7.8.0"
    },
    "peerDependenciesMeta": {
        "@angular-devkit/schematics": {
            "optional": true
        },
        "@schematics/angular": {
            "optional": true
        },
        "@ng-icons/core": {
            "optional": true
        },
        "@ng-icons/lucide": {
            "optional": true
        }
    },
    "sideEffects": false,
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "public"
    },
    "exports": {
        "./preset.css": {
            "default": "./src/styles/preset.css"
        },
        "./styles/preset.css": {
            "default": "./src/styles/preset.css"
        }
    }
}
