# ==============================================================================
# REGISTRY ROUTING & SECURITY (Anti-Dependency Confusion)
# ==============================================================================
# Private enterprise scope routed exclusively to GitHub Packages.
# Prevents npmjs.org fallback and dependency confusion attacks.
@gacc-ng:registry=https://npm.pkg.github.com

# Standard public registry for open source dependencies
registry=https://registry.npmjs.org/

# Secure credential resolution via environment variable (Zero Leaks)
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}

# ==============================================================================
# SUPPLY CHAIN ATTACK MITIGATION (Arbitrary Script Execution)
# ==============================================================================
# Block automatic execution of preinstall/install/postinstall lifecycle scripts.
# Native dependencies needing compilation must be explicitly listed in
# pnpm-workspace.yaml (allowBuilds) or manually invoked via 'pnpm rebuild'.
ignore-scripts=true

# ==============================================================================
# DETERMINISM & REPRODUCIBILITY
# ==============================================================================
# Pin exact dependency versions (no ^ or ~ ranges) to avoid compromised releases
save-exact=true

# Strictly enforce engines version definitions
engine-strict=true

# Prevent accidental npm package-lock.json generation
package-lock=false

# ==============================================================================
# RESOLUTION & ISOLATION
# ==============================================================================
# Automatically install peer dependencies deterministically
auto-install-peers=true
dedupe-peer-dependents=true

# Preserve strict isolated node_modules structure (prevents phantom dependencies)
shamefully-hoist=false
